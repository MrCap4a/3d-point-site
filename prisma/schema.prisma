// Prisma-схема проекта 3Dpoint / 3Дточка.
// СУБД: SQLite на старте (см. архитектурное решение — простой сайт с одним
// админом, без необходимости в отдельном сервере БД). При росте нагрузки
// достаточно сменить provider/url без изменения остальной архитектуры.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LeadCategory {
  PRIVATE
  BUSINESS
  SERIAL
}

enum ContactMethod {
  telegram
  phone
  email
  other
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  ARCHIVED
}

/// Заявка с сайта. Форма — не заказ и не полноценное ТЗ, поэтому большинство
/// полей необязательны, кроме имени, контакта и краткого описания задачи.
model Lead {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      LeadCategory
  name          String
  contactMethod ContactMethod
  contactValue  String
  company       String?
  description   String
  batchSize     String?
  sourcePage    String?
  /// Момент, когда посетитель отметил согласие на обработку персональных
  /// данных (152-ФЗ). null — у заявок, отправленных до появления чекбокса.
  consentAt     DateTime?
  status        LeadStatus    @default(NEW)
  spamFlag      Boolean       @default(false)
  files         LeadFile[]
}

/// Файл, приложенный к заявке (фото, чертёж, модель и т.п.).
model LeadFile {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
}

/// Кейс портфолио, управляемый через админку. Оформление в духе объявлений
/// (фото + описание + необязательные цена, материал, срок и категории).
model PortfolioCase {
  id          String           @id @default(cuid())
  title       String
  description String
  /// Цена — свободный текст (например "2500 ₽" или "от 1500 ₽"), не число:
  /// администратор сам решает, как её сформулировать. Необязательное поле.
  price       String?
  /// Материал свободным текстом (например "PETG"). Необязательное поле.
  material    String?
  /// Срок изготовления свободным текстом (например "2 дня"). Необязательное.
  leadTime    String?
  /// Категории через запятую из фиксированного набора (см.
  /// PORTFOLIO_CATEGORIES в @/lib/portfolio): private, business, scanning,
  /// agro, auto, signs. SQLite не поддерживает списки — храним строкой.
  categories  String           @default("")
  /// Фото «до» — одно из изображений этого же кейса. null — фото «до» нет.
  beforeImageId String?
  sortOrder   Int              @default(0)
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  images      PortfolioImage[]
}

model PortfolioImage {
  id        String        @id @default(cuid())
  caseId    String
  case      PortfolioCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filePath  String
  sortOrder Int           @default(0)
}

/// Простое key-value хранилище контактных данных и настроек сайта, чтобы
/// администратор мог менять их без изменения кода.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Единственная административная учётная запись (см. архитектуру админки —
/// без полноценной ролевой модели, она пока не нужна).
model AdminUser {
  id           String    @id @default(cuid())
  login        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}
